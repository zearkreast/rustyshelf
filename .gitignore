# Based on Boxshelf by sassiestrhihno (https://github.com/sassiestrhihno/boxshelf-source, GPL-3.0): most of this file is Boxshelf's
# .gitignore; modified for RustyShelf (its own start script is allowed).
# RustyShelf uses an ALLOWLIST: everything is ignored, then only the app's own source is added back.
# This keeps emulators, ROMs, BIOS, saves, art, manuals, magazines, music, console models, builds and
# personal data out of the repo, even when new folders appear next to the app.

# 1. Ignore everything
/*

# 2. Add back the app source
!/.gitignore
!/package.json
!/package-lock.json
!/main.js
!/preload.js
!/preload-home.js
!/preload-wum.js
!/main/
!/renderer/
!/docs/
!/shared/
!/android-app/
!/linux/
!/scripts/
!/release-extras/
!/.github/
!/README.md
!/LICENSE
!/THIRD-PARTY-NOTICES.md
!/*.bat
!/start-rustyshelf.sh
!/Cargo.toml
!/Cargo.lock
!/crates/

# 3. Never commit these, even inside allowed folders
target/
main/bin/
node_modules/
dist/
*.log
*.zip
*.7z
*.exe
*.iso
*.rvz
*.nsp
*.xci
*.cia
*.3ds
*.wua
*.pkg
*.bin
*.rustyshelf-bak
*.apk
*.aab
*.AppImage
*.pdb
# test and report output
linux-test-out/
community-report/
test-results/
playwright-report/
# caches, editors, the OS
__pycache__/
*.pyc
*.rs.bk
*.blend1
*.tmp
*.swp
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
# secrets and signing keys
.env
.env.*
*.key
*.pem
*.p12
*.pfx
keys.txt
prod.keys
title.keys
*.keystore
*.jks
# local notes and AI assistant files
CLAUDE.md
CLAUDE.local.md
AGENTS.md
GEMINI.md
MEMORY.md
memories.md
HANDOFF.md
.claude/
.cursor/
.mcp.json
# the 3D PC model isn't part of the public source (its origin isn't recorded)
renderer/models/*.glb
# (RustyShelf issue 27) its own keep cases are part of the source: built from renderer/models/src/keepcases.py (Blender),
# they were caught by the rule above and never reached a build, so every release fell back to the coded case
!renderer/models/case-*.glb
# (RustyShelf issue 26) the ScreenScraper developer login CI writes from secrets: never in git
main/ss-dev.json
android-app/android/app/src/main/assets/ss-dev.json
